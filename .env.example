# career-ops-deployment-kit — environment variables
# The real file lives at ../private/.env (outside this repo). Names only here.

# Notion internal integration (Phase 4)
NOTION_ACCESS_TOKEN=
NOTION_JOB_POSTINGS_DB_ID=
NOTION_COMPANY_RADAR_DB_ID=

# Search discovery via Serper.dev (Phase 5)
SERPER_API_KEY=

# Weekly email via Resend (Phase 7)
RESEND_API_KEY=
DIGEST_TO_EMAIL=

# SEC EDGAR asks for a contact in the User-Agent (Phase 6; not a secret)
SEC_USER_AGENT="career-ops-deployment-kit your-email@example.com"

# iMessage alerts need no key: they use Messages on your Mac (Phase 7)
IMESSAGE_TO=
