# career-ops-deployment-kit — keys
# install.sh copies this to ../private/.env (outside the repo). Fill in the values there, never here.

# Notion internal integration: https://www.notion.so/my-integrations
# Share one Notion page with it, then run scripts/notion.sh setup (writes config/notion.json).
NOTION_ACCESS_TOKEN=

# Serper.dev search key (job-board discovery and funding news search)
SERPER_API_KEY=

# No key needed for: iMessage alerts and the weekly email (Messages and Mail on this Mac),
# SEC Form D (contact email goes in config/sources.json), Claude (the claude CLI's own sign-in).
